<?xml version="1.0"?>
<robot name="salamander_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<!-- Lidar joint: Mantém a matemática correta para o Nav2 -->
<joint name="rplidar_a1m8_joint" type="fixed">
  <origin xyz="0.236098 -0.004646 0.000956" rpy="3.14159 0 1.5708"/>
  <parent link="base_link"/>
  <child link="rplidar_a1m8_1"/>
</joint>

<!-- Lidar frame -->
<link name="rplidar_a1m8_1">
  <inertial>
    <origin xyz="219.933902e-03 -0.526156e-03 29.599964e-03" rpy="0 0 0"/>
    <mass value="125.885678e-03"/>
    <inertia ixx="44511.257312e-09" iyy="44511.247312e-09" izz="77435.776975e-09" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <!-- A mágica matemática: isso anula a junta para o desenho renderizar como no CAD -->
    <origin xyz="0.004646 -0.236098 0.000956" rpy="3.14159 0 1.5708"/>
    <geometry>
      <mesh filename="package://salamander_bot/meshes/rplidar_a1m8_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <!-- A mágica matemática também na colisão -->
    <origin xyz="0.004646 -0.236098 0.000956" rpy="3.14159 0 1.5708"/>
    <geometry>
      <mesh filename="package://salamander_bot/meshes/rplidar_a1m8_1.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
</link>

<joint name="rplidar_a1m8_1_joint" type="fixed">
  <parent link="base_link"/>
  <child link="rplidar_a1m8_1"/>
  <origin xyz="219.933902e-03 -0.526156e-03 -10.400036e-03" rpy="0 0 0"/>
</joint>

</robot>