<link name="gripper_left">
  <inertial>
    <origin xyz="260.442473e-03 -16.618872e-03 162.503304e-03" rpy="0 0 0"/>
    <mass value="21.356874e-03"/>
    <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" iyz="0.0" ixz="0.0"/> <!-- TODO -->
