    <origin xyz="0.000482e-03 15.812434e-03 100.010944e-03" rpy="0 0 0"/>
    <mass value="1267.057673e-03"/>
    <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" iyz="0.0" ixz="0.0"/> <!-- TODO -->
