<joint name="platform_joint" type="fixed">
  <origin xyz="255.00e-03 0.0 74.50e-03" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="platform_link"/>
</joint>

<joint name="height_joint" type="continuous">
  <origin xyz="-106.224243e-03 -4.427118e-03 21.00e-03" rpy="0 0 0"/>
  <parent link="platform_link"/>
  <child link="height_link"/>
  <axis xyz="0.0 0.0 1.0"/>
</joint>

<joint name="arm_joint" type="continuous">
  <origin xyz="-0.045e-03 -43.666664e-03 162.505e-03" rpy="0 0 0"/>
  <parent link="height_link"/>
  <child link="arm_link"/>
  <axis xyz="0.0 1.0 0.0"/>
</joint>

<joint name="gripper_left_joint" type="prismatic">
  <origin xyz="248.00e-03 14.10e-03 0.0" rpy="0 0 0"/>
  <parent link="arm_link"/>
  <child link="gripper_left"/>
  <axis xyz="0.0 -1.0 0.0"/>
  <limit
    lower="0.0"
    upper="0.0125"
    effort="25"
    velocity="0.05"/>
</joint>

<joint name="gripper_right_joint" type="prismatic">
  <origin xyz="248.00e-03 -14.10e-03 0.0" rpy="0 0 0"/>
  <parent link="arm_link"/>
  <child link="gripper_right"/>
  <mimic joint="gripper_left_joint"
         multiplier="-1"
         offset="0"/>
  <axis xyz="0.0 -1.0 0.0"/>
  <limit
    lower="0.0"
    upper="0.0125"
    effort="25"
    velocity="0.05"/>
</joint>

</robot>