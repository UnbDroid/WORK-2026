<?xml version="1.0" ?>
<robot name="salamander_bot" xmlns:xacro="http://www.ros.org/wiki/xacro">

<link name="platform_link">
  <inertial>
    <origin xyz="-42.269942e-03 42.271801e-03 29.786424e-03" rpy="0 0 0"/>
    <mass value="638.06279e-03"/>
    <inertia ixx="0.001" iyy="0.001" izz="0.001" ixy="0.0" iyz="0.0" ixz="0.0"/> <!-- TODO -->
  </inertial>

  <visual>
    <origin xyz="-106.224243e-03 -4.427118e-03 21.00e-03" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://salamander_bot/meshes/platform_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
    <material name="silver"/>
  </visual>

  <collision>
    <origin xyz="-106.224243e-03 -4.427118e-03 21.00e-03" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://salamander_bot/meshes/platform_link.stl" scale="0.001 0.001 0.001"/>
    </geometry>
  </collision>
  
</link>

